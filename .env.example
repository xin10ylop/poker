# Copy to .env (never commit .env) or export in your shell.
# OpenRouter key: used for Jev (~typesafe/jev-latest) and optionally for Opus 5.5.
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: call Opus 5.5 directly on the Anthropic API instead of via OpenRouter.
# ANTHROPIC_API_KEY=sk-ant-...
# Hard spending cap for this machine (USD, all models combined).
POKERBRAIN_MAX_SPEND_USD=5
